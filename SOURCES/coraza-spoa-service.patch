From a1c64ae470208f87275d2dd7729122bca105eae3 Mon Sep 17 00:00:00 2001
From: Julien Thomas <jthomas@zenetys.com>
Date: Mon, 26 Oct 2026 10:09:06 +0100
Subject: [PATCH 1/2] REORG: systemd: Update service unit to fit our needs for
 packaging

---
 contrib/coraza-spoa.service | 21 +++++++++++++--------
 1 file changed, 13 insertions(+), 8 deletions(-)

diff --git a/contrib/coraza-spoa.service b/contrib/coraza-spoa.service
index 5b3adec..06609d2 100644
--- a/contrib/coraza-spoa.service
+++ b/contrib/coraza-spoa.service
@@ -3,7 +3,12 @@ Description=Coraza WAF SPOA Daemon
 Documentation=https://www.coraza.io
 
 [Service]
-ExecStart=/usr/bin/coraza-spoa -config=/etc/coraza-spoa/config.yaml
+Environment=CONFIG=/etc/coraza-spoa/config.yaml
+Environment=OPTIONS=
+EnvironmentFile=-/etc/sysconfig/coraza-spoa
+
+ExecStart=/usr/sbin/coraza-spoa -config ${CONFIG} $OPTIONS
+
 WorkingDirectory=/
 Restart=always
 Type=exec
@@ -56,7 +61,7 @@ InaccessiblePaths=-/bin/zcat
 InaccessiblePaths=-/bin/rm
 InaccessiblePaths=-/bin/readlink
 InaccessiblePaths=-/bin/readpath
-InaccessiblePaths=-/sbin
+#InaccessiblePaths=-/sbin
 InaccessiblePaths=-/efi
 InaccessiblePaths=-/run/media
 InaccessiblePaths=-/run/mount
@@ -248,7 +253,7 @@ InaccessiblePaths=-/usr/bin/who
 InaccessiblePaths=-/usr/bin/whoami
 InaccessiblePaths=-/usr/bin/zsh
 InaccessiblePaths=-/usr/local
-InaccessiblePaths=-/usr/sbin
+#InaccessiblePaths=-/usr/sbin
 InaccessiblePaths=-/proc/irq
 InaccessiblePaths=-/proc/kallsyms
 InaccessiblePaths=-/proc/kcore
@@ -280,10 +285,10 @@ InaccessiblePaths=-/usr/src/linux
 
 LockPersonality=true
 
-LogsDirectory=coraza-spoa
-ConfigurationDirectory=coraza-spoa
+#LogsDirectory=coraza-spoa
+#ConfigurationDirectory=coraza-spoa
 # coraza-geoip
-ReadOnlyPaths=/usr/share/GeoIP
+#ReadOnlyPaths=/usr/share/GeoIP
 #ReadOnlyPaths=/proc
 
 MemoryDenyWriteExecute=yes
@@ -305,8 +310,8 @@ SystemCallArchitectures=native
 SystemCallFilter=@system-service
 SystemCallFilter=~@setuid @ipc @mount
 
-IPAddressDeny=any
-IPAddressAllow=localhost
+#IPAddressDeny=any
+#IPAddressAllow=localhost
 
 CapabilityBoundingSet=CAP_NET_BIND_SERVICE
 
-- 
2.56.0

